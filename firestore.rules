rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can read and write their own storage.
    // The admin account can read ALL users' storage (coach/roster view).
    match /users/{userId}/storage/{docId} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId
                       || request.auth.token.email == "michaelstoics999@gmail.com");
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin needs to list /users to enumerate UIDs.
    match /users/{userId} {
      allow list: if request.auth != null
                  && request.auth.token.email == "michaelstoics999@gmail.com";
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
